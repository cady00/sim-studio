
* {
  font-family: "Inter", "HarmonyOS Sans SC", "Source Han Sans SC", "Noto Sans CJK SC", "Noto Sans SC", "Microsoft YaHei UI", "PingFang SC", sans-serif;
  color: #171D38;
  font-size: 12px;
}
QMainWindow, QDialog {
  background: #EEF0F7;
}
QMenuBar, QStatusBar, #chrome {
  background: #FFFFFF;
  color: #4C5373;
  border: none;
}
QStatusBar {
  border-top: 1px solid #EAECF3;
  font-size: 11px;
}
QMenuBar::item:selected, QMenu::item:selected {
  background: #E4E7F6;
  color: #171D38;
}
QMenu {
  background: #FFFFFF;
  border: 1px solid #E1E4EE;
  padding: 4px;
}
QDockWidget {
  color: #4C5373;
  titlebar-close-icon: none;
}
QDockWidget::title {
  background: #FFFFFF;
  padding: 6px 8px;
  border-bottom: 1px solid #EAECF3;
  text-align: left;
}
QTreeWidget, QTableWidget, QListWidget, QPlainTextEdit, QTextEdit {
  background: #FFFFFF;
  alternate-background-color: #F6F7FB;
  border: none;
  selection-background-color: #E4E7F6;
  selection-color: #171D38;
}
QHeaderView::section {
  background: #FFFFFF;
  color: #767C9C;
  border: none;
  border-bottom: 1px solid #EAECF3;
  padding: 4px 6px;
}
QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox {
  background: #F7F8FC;
  border: 1px solid #E1E4EE;
  border-radius: 6px;
  padding: 3px 6px;
  min-height: 20px;
  selection-background-color: #5C60C2;
  selection-color: #FFFFFF;
}
QPushButton {
  background: #F6F7FB;
  border: 1px solid #CDD1E0;
  border-radius: 7px;
  padding: 4px 10px;
  min-height: 22px;
}
QPushButton:hover {
  background: #ECEEF6;
}
QPushButton:checked, QToolButton:checked {
  background: #E4E7F6;
  border: 1px solid #5C60C2;
  color: #171D38;
}
QToolButton {
  background: transparent;
  border: none;
  border-radius: 7px;
  color: #4C5373;
  padding: 4px;
}
QToolButton:hover {
  background: #ECEEF6;
  color: #171D38;
}
QScrollBar:vertical {
  background: #FFFFFF;
  width: 10px;
}
QScrollBar::handle:vertical {
  background: #CDD1E0;
  border-radius: 4px;
  min-height: 24px;
}
#modeButton {
  color: #4C5373;
  background: transparent;
  border-radius: 7px;
  padding: 4px 10px;
}
#modeButton:checked {
  background: #E4E7F6;
  color: #171D38;
  border: 1px solid #5C60C2;
}
#commandHint, #intentBar, #commandPalette, #overlayGlass {
  background: #FFFFFF;
  border: 1px solid #E1E4EE;
  border-radius: 12px;
}
#accentButton {
  background: #5C60C2;
  color: #FFFFFF;
  border: none;
  font-weight: 600;
}
