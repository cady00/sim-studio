{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 24,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-msvc",
      "displayName": "Windows MSVC + vcpkg",
      "description": "Visual Studio 2022 x64. Requires VCPKG_ROOT. Uses the release-only dynamic triplet so Qt stays LGPL-friendly.",
      "generator": "Visual Studio 17 2022",
      "architecture": {
        "value": "x64",
        "strategy": "set"
      },
      "binaryDir": "${sourceDir}/out/build/windows-msvc",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_TARGET_TRIPLET": "x64-windows-release",
        "SIMSTUDIO_BUILD_TESTS": "ON",
        "SIMSTUDIO_BUILD_APP": "ON"
      }
    },
    {
      "name": "linux-system",
      "displayName": "Linux GCC system packages",
      "description": "Ninja + distro Qt 6 / OpenCASCADE. Same find_package interface as vcpkg; used to verify tests without compiling Qt and OCCT from source.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/linux-system",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_CXX_COMPILER": "/usr/bin/g++",
        "CMAKE_C_COMPILER": "/usr/bin/gcc",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-msvc-release",
      "configurePreset": "windows-msvc",
      "configuration": "Release"
    },
    {
      "name": "linux-system",
      "configurePreset": "linux-system"
    }
  ],
  "testPresets": [
    {
      "name": "windows-msvc-release",
      "configurePreset": "windows-msvc",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "linux-system",
      "configurePreset": "linux-system",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
